# 虚拟环境（由 install.ps1 / install.sh 生成）
.venv/

# Python 缓存
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# 生成的音频
output.wav
*.wav
*.mp3

# 大体积模型权重（请从 Hugging Face 下载，见 README）
checkpoints/gpt.pth
checkpoints/codec.pth
checkpoints/s2mel.pth
checkpoints/hf_cache/

# Qwen 情感模型（WebUI 的「用情感描述文本控制」需要，约 1.2 GB）
checkpoints/qwen0.6bemo4-merge/

# 下载权重时由 Hugging Face 一并落盘的仓库文件（模型卡 + LFS 配置）
checkpoints/README.md
checkpoints/.gitattributes

# huggingface_hub 的下载缓存
checkpoints/.cache/

# 系统文件
.DS_Store
Thumbs.db

# 编辑器
.vscode/
.idea/
*.swp
